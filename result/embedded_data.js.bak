unt": 18, "avg_5d_return": 0.45, "win_rate": 66.7}, "接近超买": {"count": 9, "avg_5d_return": 0.23, "win_rate": 55.6}, "超买": {"count": 3, "avg_5d_return": -0.21, "win_rate": 66.7}}, "weekly_rsi": {"value": 54.3, "percentile": 34.2, "zone": "偏强", "mean": 58.4, "min": 19.3, "max": 91.2, "total_weeks": 588, "as_of": "2026-10-09"}, "scoring": {"opportunity_score": 37.0, "risk_score": 21.0, "action": "hold", "action_label": "⏸ 持有", "details": {"opportunity": {"rsi_percentile": {"score": 60, "weight": 0.25, "value": 28.2}, "bollinger": {"score": 20, "weight": 0.15, "value": "中性"}, "backtest_winrate": {"score": 20, "weight": 0.2, "value": null, "threshold": 0}, "momentum": {"score": 40, "weight": 0.1}, "extremes": {"score": 20, "weight": 0.1, "value": 16.6}, "multi_tf_rsi": {"score": 40, "weight": 0.1, "value": "多周期不一致 (震荡)"}, "trend_strength": {"score": 50, "weight": 0.1, "value": ""}}, "risk": {"rsi_percentile": {"score": 0, "weight": 0.25, "value": 28.2}, "bollinger": {"score": 20, "weight": 0.15, "value": "中性"}, "backtest_droprate": {"score": 20, "weight": 0.2, "value": null, "threshold": 0}, "momentum": {"score": 40, "weight": 0.1}, "overbought_duration": {"score": 10, "weight": 0.1}, "multi_tf_rsi": {"score": 40, "weight": 0.1, "value": "多周期不一致 (震荡)"}, "trend_strength": {"score": 50, "weight": 0.1, "value": ""}}}}, "full_ta_summary": {"overall": "多空交织", "bull": 2, "bear": 2, "details": ["KDJ 极度超买", "W%R=-19.6 超买"], "rsi_zone": "弱势区", "macd_signal": "DIF>DEA多头", "ma_alignment": "均线缠绕", "boll_position": "中轨上方", "kdj_signal": "极度超买", "stoch_zone": "正常", "cci_zone": "正常", "wr_zone": "超买", "obv_trend": "资金流入", "adx_value": 31.72, "adx_trend": "趋势明显", "adx_direction": "空头", "mfi_value": 31.87, "mfi_zone": "偏低", "trend_direction": "横盘", "trend_strength": "无", "rsi_divergence": "", "volume_price_pattern": "量价正常", "change_5d": 1.91, "change_20d": -1.16, "change_50d": -1.78, "change_200d": 10.86, "max_drawdown": -35.1, "swing_high": 79.61, "swing_low": 75.39, "ema60_value": 77.2339, "ema60_distance": -0.46, "ema60_price_source": "close", "data_source": "腾讯财经(美股qfq+快照)", "price_basis": "adjusted_close", "latest_verified": null, "expected_records": null, "parsed_records": 2896, "analysis_start_override": null, "source_history_start": null, "as_of": "2026-10-08"}, "full_ta_llm": "**重要提示：数据不同步，无法给出操作结论**\n\n本报告所依据的RSI面板历史数据截止日为2026年10月8日，而完整技术分析报告的最新展示价同为2026年10月8日，两者日期一致，数据同步。以下分析均基于输入数据。\n\n---\n\n### 综合投资建议：观望\n\n#### 一、趋势与多空信号解读\n\n当前DGRO处于**横盘震荡**格局，均线系统呈现“均线缠绕”状态，趋势强度为“无”，ADX虽录得31.72显示“趋势明显”，但+DI（21.49）低于-DI（25.87），方向明确指向**空头**。价格位于EMA50和EMA60下方，但站上EMA200，表明中期承压、长期趋势尚存。\n\n多空信号方面，综合判断为“多空交织”，多空比2:2。多头信号来自MACD（DIF=-0.5409上穿DEA=-0.6421，柱状线连续五日扩张至0.2025）和OBV（5日均高于10日均，显示资金流入）。空头信号则来自KDJ的J值飙升至115.13（极度超买）和Williams %R录得-19.65（超买），两者均提示短期过热风险。\n\n#### 二、RSI面板与历史极值回测的推断\n\nRSI(14)当前值为48.8，处于28.2%的历史分位，位于“弱势区”，面板建议“可开始关注，等待更好入场点”。多周期RSI不一致（日线弱势，周线54.3偏强），进一步印证震荡格局。MFI录得31.87（偏低），与RSI弱势状态吻合，显示资金流入强度不足。\n\n历史极值回测数据显示，在RSI跌入16-18极端超卖区间后，中期反弹概率较高：如2018年12月24日RSI=18.1时，后续60日收益高达+16.1%。当前RSI=48.8远高于历史极值水平，**并未出现类似的历史极端买入信号**，不具备高胜率抄底条件。\n\n#### 三、关键价位与风险点\n\n价格最新报76.88，位于布林带中轨（76.6415）上方，%B为57.8%，上方阻力关注上轨78.17及斐波那契回撤位77.99（61.8%）。下方支撑参考波段低点75.39及布林带下轨75.11。主要风险在于：KDJ极度超买后可能引发短线回调，且-DI占据优势，若价格跌破EMA20（76.74）及中轨支撑，空头动能或进一步释放。\n\n#### 四、操作建议\n\n综合判断，当前DGRO处于中期偏弱、短期超买的矛盾状态，缺乏明确的趋势性机会。RSI未触及历史极端超卖区，追高面临技术性回调风险，做空又受长期均线支撑制约。建议**观望**，等待RSI回落至更极端分位或价格有效突破79.08阻力位再行决策。", "full_ta_report": "# DGRO 全面技术分析报告\n**核心股利增长ETF-iShares** | 2015-03-31 ~ 2026-10-08 | 2896个数据点\n最新展示价: **76.88** (2026-10-08)\n\n## 一、涨跌幅统计\n\n5d: +1.91% | 10d: +0.97% | 20d: -1.16% | 50d: -1.78% | 100d: +4.8% | 200d: +10.86%\n最大回撤: -35.1%\n\n## 二、均线系统\n\n| 均线 | 值 | 价格位置 | 偏离度 |\n|------|-----|---------|--------|\n| EMA5 | 76.4156 | 上方 | +0.61% |\n| EMA10 | 76.3663 | 上方 | +0.67% |\n| EMA20 | 76.7403 | 上方 | +0.18% |\n| EMA50 | 77.2848 | 下方 | -0.52% |\n| EMA60 | 77.2339 | 下方 | -0.46% |\n| EMA100 | 76.6175 | 上方 | +0.34% |\n| EMA200 | 74.5131 | 上方 | +3.18% |\n**均线排列: 均线缠绕**\n\n### 趋势强度\n\n- 方向: **横盘** | 强度: **无**\n- 偏离MA20: +0.31%\n- 10日斜率: +0.40%\n\n## 三、MACD (12,26,9)\n\n- DIF: -0.5409\n- DEA: -0.6421\n- MACD柱: 0.2025\n- 信号: **DIF>DEA多头**\n\n近期趋势:\n  DIF=-0.7932, DEA=-0.6551, 柱=-0.2761\n  DIF=-0.7569, DEA=-0.6755, 柱=-0.1629\n  DIF=-0.6808, DEA=-0.6765, 柱=-0.0086\n  DIF=-0.631, DEA=-0.6674, 柱=0.0729\n  DIF=-0.5409, DEA=-0.6421, 柱=0.2025\n\n## 四、KDJ (9,3,3)\n\n- K: 72.04, D: 50.49, J: 115.13\n- 信号: **K>D** | 区域: 极度超买\n\n## 五、Stochastic (14,3,3)\n\n- SlowK: 66.98, SlowD: 54.64\n- 区域: 正常\n\n## 六、布林带 (20,2)\n\n- 上轨: 78.1739\n- 中轨: 76.6415\n- 下轨: 75.1091\n- %B: 57.8%\n- 带宽: 4.0%\n- 位置: **中轨上方**\n\n## 七、ATR (14) 波动率\n\n- ATR: 0.6128\n- 占价格比: 0.8%\n\n## 八、CCI (14)\n\n- CCI: 61.4 | 区域: 正常\n\n## 九、Williams %R (14)\n\n- %R: -19.65 | 区域: 超买\n\n## 十、ADX (14) 趋势强度\n\n- ADX: 31.72 | 趋势: **趋势明显**\n- +DI: 21.49 | -DI: 25.87\n- 方向: **空头**\n\n## 十一、MFI (14) 资金流量指数\n\n- MFI: 31.87 | 区域: **偏低**\n\n## 十二、OBV 能量潮\n\n- OBV: 180,269,980.0\n- 5日均: 179,192,877\n- 10日均: 177,460,147\n- 趋势: **资金流入**\n\n## 十三、成交量\n\n- 当日: 1,271,318\n- 5日均量: 1,361,003\n- 量比: 0.93\n\n### 量价关系\n\n- 形态: **量价正常**\n- 20日价格变化: -1.74%\n- 20日量变化: -0.03%\n- 5日/20日均量比: 0.88\n\n## 十五、关键价位\n\n- 波段高: 79.61\n- 波段低: 75.39\n- 波幅: 5.6%\n\n**斐波那契回撤位:**\n- 23.6%: 76.3859\n- 38.2%: 77.002\n- 50.0%: 77.5\n- 61.8%: 77.998\n- 78.6%: 78.7069\n\n**自动识别支撑位:** 75.39\n**自动识别阻力位:** 79.08\n\n## 十六、综合信号\n\n**多空比: 2 : 2**\n**综合判断: 多空交织**\n\n信号明细:\n- KDJ 极度超买\n- W%R=-19.6 超买\n\n---\n*免责声明: 基于历史数据的技术指标计算，不构成投资建议。*\n\n---\n\n## 十四、AI 综合投资建议\n\n**重要提示：数据不同步，无法给出操作结论**\n\n本报告所依据的RSI面板历史数据截止日为2026年10月8日，而完整技术分析报告的最新展示价同为2026年10月8日，两者日期一致，数据同步。以下分析均基于输入数据。\n\n---\n\n### 综合投资建议：观望\n\n#### 一、趋势与多空信号解读\n\n当前DGRO处于**横盘震荡**格局，均线系统呈现“均线缠绕”状态，趋势强度为“无”，ADX虽录得31.72显示“趋势明显”，但+DI（21.49）低于-DI（25.87），方向明确指向**空头**。价格位于EMA50和EMA60下方，但站上EMA200，表明中期承压、长期趋势尚存。\n\n多空信号方面，综合判断为“多空交织”，多空比2:2。多头信号来自MACD（DIF=-0.5409上穿DEA=-0.6421，柱状线连续五日扩张至0.2025）和OBV（5日均高于10日均，显示资金流入）。空头信号则来自KDJ的J值飙升至115.13（极度超买）和Williams %R录得-19.65（超买），两者均提示短期过热风险。\n\n#### 二、RSI面板与历史极值回测的推断\n\nRSI(14